@inject CotizacionService Cotizacion
@inject PdfService Pdf
@inject ParametrosService Parametros
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="card shadow-sm border-0 mt-3">
    <div class="card-body">
        <button type="button" class="btn btn-outline-success w-100" @onclick="MostrarFormulario">
            <span class="me-1">&#128424;</span> Exportar cotización PDF
        </button>

        @if (_visible)
        {
            <div class="mt-3">
                <h3 class="h6">Datos de la cotización</h3>
                <p class="small text-secondary">
                    Se incluirán en el membrete del reporte. Quedan guardados en este dispositivo.
                </p>

                <div class="row g-2">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold" for="cot-solicitante">Solicitante</label>
                        <input id="cot-solicitante" type="text" class="form-control form-control-sm"
                               value="@_solicitante.Solicitante" @oninput="e => _solicitante.Solicitante = Valor(e)" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold" for="cot-ci">C.I. / NIT</label>
                        <input id="cot-ci" type="text" class="form-control form-control-sm"
                               value="@_solicitante.Ci" @oninput="e => _solicitante.Ci = Valor(e)" />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold" for="cot-matricula">Matrícula</label>
                        <input id="cot-matricula" type="text" class="form-control form-control-sm"
                               value="@_solicitante.Matricula" @oninput="e => _solicitante.Matricula = Valor(e)" />
                    </div>
                    <div class="col-12 col-md-8">
                        <label class="form-label small fw-semibold" for="cot-direccion">Dirección</label>
                        <input id="cot-direccion" type="text" class="form-control form-control-sm"
                               value="@_solicitante.Direccion" @oninput="e => _solicitante.Direccion = Valor(e)" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label small fw-semibold" for="cot-municipio">Municipio</label>
                        <input id="cot-municipio" type="text" class="form-control form-control-sm"
                               value="@_solicitante.Municipio" @oninput="e => _solicitante.Municipio = Valor(e)" />
                    </div>
                    <div class="col-6 col-md-6">
                        <label class="form-label small fw-semibold" for="cot-profesional">Profesional</label>
                        <input id="cot-profesional" type="text" class="form-control form-control-sm"
                               value="@_profesional" @oninput="e => _profesional = Valor(e)" />
                    </div>
                    <div class="col-6 col-md-6">
                        <label class="form-label small fw-semibold" for="cot-matricula-prof">Matrícula profesional</label>
                        <input id="cot-matricula-prof" type="text" class="form-control form-control-sm"
                               value="@_matriculaProfesional" @oninput="e => _matriculaProfesional = Valor(e)" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="cot-observaciones">Observaciones</label>
                        <textarea id="cot-observaciones" rows="2" class="form-control form-control-sm"
                                  value="@_observaciones" @oninput="e => _observaciones = Valor(e)"></textarea>
                    </div>
                </div>

                @if (_mensaje is not null)
                {
                    <div class="alert @(_error ? "alert-danger" : "alert-success") py-2 px-3 small mt-3 mb-0">
                        @_mensaje
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-sm btn-success flex-grow-1" @onclick="Compartir"
                            disabled="@_procesando">
                        <span class="me-1">&#128253;</span> Compartir
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" @onclick="Imprimir"
                            disabled="@_procesando">
                        Imprimir
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary flex-grow-1" @onclick="CopiarEnlace"
                            disabled="@_procesando">
                        <span class="me-1">&#128279;</span> Copiar enlace
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public ResultadoArancel? Resultado { get; set; }

    private bool _visible;
    private bool _procesando;
    private bool _error;
    private string? _mensaje;
    private DatosSolicitante _solicitante = new();
    private string _profesional = string.Empty;
    private string _matriculaProfesional = string.Empty;
    private string _observaciones = string.Empty;

    protected override void OnInitialized() => _solicitante = Cotizacion.Solicitante;

    private void MostrarFormulario()
    {
        _visible = !_visible;
        _solicitante = Cotizacion.Solicitante;
    }

    private static string Valor(ChangeEventArgs e) => e.Value?.ToString() ?? string.Empty;

    private async Task<ReporteCotizacion?> PrepararAsync()
    {
        if (Resultado is null)
            return null;

        await Cotizacion.GuardarSolicitanteAsync(_solicitante);

        return await Cotizacion.GenerarAsync(
            Resultado,
            Parametros.Actual.Copia(),
            _profesional,
            _matriculaProfesional,
            _observaciones);
}

    private async Task Compartir()
    {
        var reporte = await PrepararAsync();

        if (reporte is null)
            return;

        _procesando = true;
        _error = false;
        _mensaje = null;

        try
        {
            var html = Pdf.ConstruirHtml(reporte);
            
            // Intentar Web Share API para archivos (PDF)
            var compartido = await JS.InvokeAsync<bool>("caoShare.compartirArchivo", 
                $"Cotizacion-{reporte.Numero}.pdf", 
                "application/pdf", 
                html);

            if (compartido)
            {
                _mensaje = "Cotización compartida correctamente.";
            }
            else
            {
                // Fallback: compartir texto/enlace
                await CompartirEnlace(reporte);
            }
        }
        catch (Exception ex)
        {
            _error = true;
            _mensaje = $"Error al compartir: {ex.Message}";
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task CompartirEnlace(ReporteCotizacion reporte)
    {
        var enlace = $"{Navigation.BaseUri}cotizacion/{reporte.Numero}";
        var texto = $"Cotización CAO #{reporte.Numero}\n{reporte.Resultado.Concepto}\nTotal: {reporte.Resultado.TotalEnLetras}\n\nVer en: {enlace}";

        try
        {
            await JS.InvokeVoidAsync("caoShare.compartirTexto", "Cotización CAO", texto, enlace);
            _mensaje = "Enlace copiado y listo para compartir por WhatsApp/Telegram.";
        }
        catch
{
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", texto);
        _mensaje = "Enlace copiado al portapapeles. Pégalo en WhatsApp/Telegram.";
    }
}

    private async Task CopiarEnlace()
    {
        if (Resultado is null) return;

        var reporte = await PrepararAsync();
        if (reporte is null) return;

        await CompartirEnlace(reporte);
    }

    private async Task Imprimir()
    {
        var reporte = await PrepararAsync();

        if (reporte is null)
            return;

        _procesando = true;
        _error = false;
        _mensaje = null;

        try
        {
            await Pdf.ImprimirAsync(reporte);
        }
        catch (Exception ex)
        {
            _error = true;
            _mensaje = $"No fue posible abrir la impresión: {ex.Message}";
        }
        finally
        {
            _procesando = false;
        }
    }
}
