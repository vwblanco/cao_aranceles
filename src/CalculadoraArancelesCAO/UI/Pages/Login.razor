@page "/login"
@inject AutenticacionService Auth
@inject NavigationManager Navigation

<PageTitle>Acceso staff | CAO</PageTitle>

<div class="min-vh-100 d-flex align-items-center justify-content-center login-fondo">
    <div class="card shadow-lg border-0 w-100" style="max-width: 420px;">
        <div class="card-header text-white text-center py-3" style="background: var(--cao-naranja);">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                <img src="CAO-192.png" height="48" alt="CAO" />
            </div>
            <div class="fw-bold fs-5">Calculadora de Aranceles</div>
            <small class="opacity-75">Colegio de Arquitectos de Oruro</small>
        </div>

        <div class="card-body p-4">
            @if (ErrorMessage is not null)
            {
                <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                    @ErrorMessage
                </div>
            }

            @if (Paso == PasoCrearPin)
            {
                <div>
                    <h4 class="text-center mb-2">Proteja este dispositivo</h4>
                    <p class="small text-muted text-center mb-3">
                        Cree un PIN de 4 digitos. Si presta el celular con la sesion abierta,
                        la aplicacion lo pedira al volver a abrirse.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="pinNuevo">PIN de 4 digitos</label>
                        <input type="password" class="form-control form-control-sm text-center fs-5"
                               id="pinNuevo" value="@Pin" maxlength="4"
                               @oninput="e => Pin = e.Value?.ToString() ?? string.Empty" autocomplete="off" />
                    </div>

                    <button type="button" class="btn btn-primary w-100 py-2" disabled="@Cargando" @onclick="EstablecerPinAsync">
                        @if (Cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Guardando...</span>
                        }
                        else
                        {
                            <span>Guardar PIN y continuar</span>
                        }
                    </button>
                    <button type="button" class="btn btn-link w-100 btn-sm mt-2" @onclick="OmitirPin">
                        Ahora no
                    </button>
                </div>
            }
            else if (Paso == PasoVerificarPin)
            {
                <div>
                    <h4 class="text-center mb-2">Sesion bloqueada</h4>
                    <p class="small text-muted text-center mb-3">
                        Ingrese su PIN de 4 digitos para continuar.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="pinActual">PIN</label>
                        <input type="password" class="form-control form-control-sm text-center fs-5"
                               id="pinActual" value="@Pin" maxlength="4"
                               @oninput="e => Pin = e.Value?.ToString() ?? string.Empty" autocomplete="off" />
                    </div>

                    <button type="button" class="btn btn-primary w-100 py-2" disabled="@Cargando" @onclick="VerificarPinAsync">
                        @if (Cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Verificando...</span>
                        }
                        else
                        {
                            <span>Desbloquear</span>
                        }
                    </button>
                </div>
            }
            else
            {
                <h4 class="text-center mb-2">Acceso del Colegio</h4>
                <p class="text-muted small text-center mb-4">
                    Reserved para el Administrador y el personal autorizado
                </p>

                <form @onsubmit="HandleLoginAsync" @onsubmit:preventDefault autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="numeroRegistro">N&ordm; Registro CAO</label>
                        <input type="text" class="form-control form-control-sm" id="numeroRegistro"
                               value="@NumeroRegistro" @oninput="e => NumeroRegistro = e.Value?.ToString() ?? string.Empty"
                               autocomplete="off" inputmode="numeric" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="clave">Clave</label>
                        <input type="password" class="form-control form-control-sm" id="clave"
                               value="@Clave" @oninput="e => Clave = e.Value?.ToString() ?? string.Empty"
                               autocomplete="current-password" />
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="recordar" @bind="Recordar" />
                        <label class="form-check-label small" for="recordar">Recordar sesi&oacute;n</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2" disabled="@Cargando">
                        @if (Cargando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Verificando...</span>
                        }
                        else
                        {
                            <span>Ingresar</span>
                        }
                    </button>
                </form>

                <a class="btn btn-link w-100 btn-sm mt-2" href="">Volver a la calculadora</a>
            }

            <div class="text-center mt-3">
                <small class="text-muted">
                    <strong>Colegio de Arquitectos de Oruro</strong><br />
                    Calculadora de Aranceles &middot; Reglamento 2026
                </small>
            </div>
        </div>
    </div>
</div>

@code {
    private const string PasoCredenciales = "Credenciales";
    private const string PasoCrearPin = "CrearPin";
    private const string PasoVerificarPin = "VerificarPin";

    private string Paso { get; set; } = PasoCredenciales;

    private string NumeroRegistro { get; set; } = string.Empty;
    private string Clave { get; set; } = string.Empty;
    private bool Recordar { get; set; } = true;
    private bool Cargando { get; set; }
    private string? ErrorMessage { get; set; }
    private string Pin { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Si la sesion sigue abierta pero vencio el reloj de inactividad, alcanza con
        // el PIN: no se vuelven a pedir registro ni clave.
        if (await Auth.DeboBloquearAsync())
        {
            Paso = PasoVerificarPin;
        }
    }

    private async Task HandleLoginAsync()
    {
        ErrorMessage = null;
        Cargando = true;

        try
        {
            var resultado = await Auth.LoginAsync(NumeroRegistro, Clave, Recordar);

            if (!resultado.Exitoso)
            {
                ErrorMessage = resultado.Mensaje;
                Clave = string.Empty;
                return;
            }

            Pin = string.Empty;
            Clave = string.Empty;

            // RequierePin indica que este dispositivo ya tiene un PIN configurado:
            // hay que verificarlo. Si no, se ofrece crear uno.
            Paso = resultado.RequierePin ? PasoVerificarPin : PasoCrearPin;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task EstablecerPinAsync()
    {
        ErrorMessage = null;
        Cargando = true;

        try
        {
            var (exitoso, mensaje) = await Auth.EstablecerPinAsync(Pin);
            if (!exitoso)
            {
                ErrorMessage = mensaje;
                return;
            }

            IrAlInicio();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            Cargando = false;
        }
    }

    private async Task VerificarPinAsync()
    {
        ErrorMessage = null;
        Cargando = true;

        try
        {
            var (exitoso, mensaje) = await Auth.VerificarPinAsync(Pin);
            if (exitoso)
            {
                IrAlInicio();
                return;
            }

            ErrorMessage = mensaje;
            Pin = string.Empty;

            if (mensaje.Contains("cerro la sesion", StringComparison.OrdinalIgnoreCase))
            {
                Paso = PasoCredenciales;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            Cargando = false;
        }
    }

    private void OmitirPin()
    {
        Pin = string.Empty;
        IrAlInicio();
    }

    private void IrAlInicio() => Navigation.NavigateTo("/", true);
}