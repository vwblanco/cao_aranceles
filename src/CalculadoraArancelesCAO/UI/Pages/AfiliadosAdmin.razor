@page "/afiliados-admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Staff")]
@using CalculadoraArancelesCAO.UI.Services
@inject AfiliadosService Afiliados
@inject IJSRuntime JS

<PageTitle>Administrar Afiliados | CAO</PageTitle>

<h1 class="h4 mb-3">
    <span class="me-2">&#128203;</span> Gesti&oacute;n de Afiliados
</h1>

<p class="text-muted small mb-4">
    Cargue el archivo Excel con la lista de afiliados autorizados.
    Columnas requeridas: <strong>Registro nacional</strong>, <strong>Apellidos y nombres</strong>, <strong>Cedula identidad</strong>.
    Opcional: <strong>Vigente</strong> (Si/No).
</p>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label small fw-semibold">Archivo Excel (.xlsx)</label>
            <InputFile class="form-control form-control-sm" accept=".xlsx,.xls" OnChange="OnFileSelected" />
            @if (archivoSeleccionado)
            {
                <div class="form-text">
                    <strong>@nombreArchivo</strong> (@(tamanoArchivo / 1024) KB) listo para procesar
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" @onclick="ProcesarArchivo" disabled="@(!archivoSeleccionado || procesando)">
                @if (procesando)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span><span>Procesando...</span>
                }
                else
                {
                    <span>Cargar y Validar</span>
                }
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="LimpiarArchivo" disabled="@(!archivoSeleccionado)">
                Limpiar
            </button>
        </div>

        @if (mensaje is not null)
        {
            <div class="alert @(exito ? "alert-success" : "alert-danger") py-2 px-3 small mt-3 mb-0">
                @mensaje
            </div>
        }
    </div>
</div>

@if (resultado?.Afiliados?.Count > 0)
{
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Vista Previa (<strong>@resultado.Afiliados.Count</strong> afiliados cargados)</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 110px;">N&ordm; Correlativo</th>
                            <th style="width: 110px;">Registro Nacional</th>
                            <th>Apellidos y Nombres</th>
                            <th style="width: 140px;">C&eacute;dula Identidad</th>
                            <th style="width: 80px;">Vigente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in GetPaginatedResultados())
                        {
                            <tr>
                                <td class="small">@a.Correlativo</td>
                                <td class="small fw-medium">@a.NumeroRegistro</td>
                                <td class="small">@a.Nombre</td>
                                <td class="small text-center">@a.CI</td>
                                <td class="text-center">
                                    @if (a.Vigente)
                                    {
                                        <span class="badge text-bg-warning">Si</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">No</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (resultado.Afiliados.Count > PageSize)
            {
                <div class="card-footer bg-light py-2">
                    <nav aria-label="Paginacion resultados">
                        <ul class="pagination pagination-sm mb-0 justify-content-center">
                            <li class="page-item @(ResultadoPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => CambiarPaginaResultado(ResultadoPage - 1)">Anterior</a>
                            </li>
                            @for (var i = 1; i <= TotalResultadoPages; i++)
                            {
                                <li class="page-item @(ResultadoPage == i ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => CambiarPaginaResultado(i)">@i</a>
                                </li>
                            }
                            <li class="page-item @(ResultadoPage == TotalResultadoPages ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => CambiarPaginaResultado(ResultadoPage + 1)">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                    <small class="text-muted d-block text-center mt-1">
                        Mostrando @((ResultadoPage - 1) * PageSize + 1) - @(Math.Min(ResultadoPage * PageSize, resultado.Afiliados.Count)) de @resultado.Afiliados.Count
                    </small>
                </div>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mt-3 flex-wrap">
        <div class="form-check me-3 d-flex align-items-center">
            <input type="checkbox" class="form-check-input" id="reemplazarDuplicados" @bind="ReemplazarDuplicados" />
            <label class="form-check-label small ms-1" for="reemplazarDuplicados">
                Reemplazar duplicados (desmarcar para mantener los actuales)
            </label>
        </div>
        <button type="button" class="btn btn-primary" @onclick="GuardarAfiliados">
            Guardar Lista
        </button>
        <button type="button" class="btn btn-outline-danger" @onclick="LimpiarTodo">
            Limpiar Todo
        </button>
    </div>
}

@if (afiliadosGuardados is { Count: > 0 } && resultado is null)
{
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Afiliados Guardados (<strong>@afiliadosGuardados.Count</strong>)</h5>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-success" @onclick="AbrirModalNuevoAfiliado">
                    <span class="me-1">&#128197;</span> Agregar Afiliado
                </button>
                @if (Seleccionados.Any())
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="EliminarSeleccionados">
                        <span class="me-1">&#128465;</span> Eliminar Seleccionados (@Seleccionados.Count)
                    </button>
                }
                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ConfirmarEliminarTodo">
                    <span class="me-1">&#128465;</span> Eliminar Todos
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">
                                <input type="checkbox" class="form-check-input" @bind="SeleccionarTodos" @bind:event="onchange" />
                            </th>
                            <th style="width: 110px;">N&ordm; Correlativo</th>
                            <th style="width: 110px;">Registro Nacional</th>
                            <th>Apellidos y Nombres</th>
                            <th style="width: 140px;">C&eacute;dula Identidad</th>
                            <th style="width: 80px;">Vigente</th>
                            <th style="width: 100px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in GetPaginatedGuardados())
                        {
                            <tr class="@(Seleccionados.Contains(a.NumeroRegistro) ? "table-active" : "")">
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@Seleccionados.Contains(a.NumeroRegistro)" @onchange="e => ToggleSeleccion(a.NumeroRegistro, e.Value is true)" />
                                </td>
                                <td class="small">@a.Correlativo</td>
                                <td class="small fw-medium">@a.NumeroRegistro</td>
                                <td class="small">@a.Nombre</td>
                                <td class="small text-center">@a.CI</td>
                                <td class="text-center">
                                    @if (a.Vigente)
                                    {
                                        <span class="badge text-bg-warning">Si</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">No</span>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarEliminarUno(a)" title="Eliminar">
                                        &#128465;
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (afiliadosGuardados.Count > PageSize)
            {
                <div class="card-footer bg-light py-2">
                    <nav aria-label="Paginacion guardados">
                        <ul class="pagination pagination-sm mb-0 justify-content-center">
                            <li class="page-item @(GuardadosPage == 1 ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => CambiarPaginaGuardados(GuardadosPage - 1)">Anterior</a>
                            </li>
                            @for (var i = 1; i <= TotalGuardadosPages; i++)
                            {
                                <li class="page-item @(GuardadosPage == i ? "active" : "")">
                                    <a class="page-link" href="#" @onclick="() => CambiarPaginaGuardados(i)">@i</a>
                                </li>
                            }
                            <li class="page-item @(GuardadosPage == TotalGuardadosPages ? "disabled" : "")">
                                <a class="page-link" href="#" @onclick="() => CambiarPaginaGuardados(GuardadosPage + 1)">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                    <small class="text-muted d-block text-center mt-1">
                        Mostrando @((GuardadosPage - 1) * PageSize + 1) - @(Math.Min(GuardadosPage * PageSize, afiliadosGuardados.Count)) de @afiliadosGuardados.Count
                    </small>
                </div>
            }
        </div>
    </div>
}

@if (afiliadosGuardados is null or { Count: 0 })
{
    <div class="alert alert-info mt-4">
        <h6 class="alert-heading">Formato del Archivo Excel</h6>
        <p class="mb-2 small">El archivo debe tener las siguientes columnas en la primera fila:</p>
        <table class="table table-sm table-bordered small">
            <thead><tr><th>Columna</th><th>Requerida</th><th>Ejemplo</th></tr></thead>
            <tbody>
                <tr><td><code>Numero correlativo</code></td><td>No</td><td>1</td></tr>
                <tr><td><code>Registro nacional</code></td><td>Si</td><td>12345</td></tr>
                <tr><td><code>Apellidos y nombres</code></td><td>Si</td><td>BLANCO VICTOR</td></tr>
                <tr><td><code>Cedula identidad</code></td><td>Si</td><td>1234567 LP</td></tr>
                <tr><td><code>Vigente</code></td><td>No</td><td>Si / No</td></tr>
            </tbody>
        </table>
        <p class="mb-0 small mt-2">
            La primera fila debe ser encabezados. Los datos inician en la fila 2.
            La deteccion de columnas no distingue mayusculas de minusculas.
        </p>
    </div>
}

@if (MostrarModalNuevo)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);" @onclick="CerrarModalNuevo">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar Afiliado @(EditandoAfiliado != null ? " (Editar)" : "")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalNuevo" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form @onsubmit="GuardarAfiliadoModal" @onsubmit:preventDefault>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">N&ordm; Correlativo</label>
                                <input type="text" class="form-control form-control-sm" value="@NuevoCorrelativo" @oninput="e => NuevoCorrelativo = e.Value?.ToString() ?? string.Empty" placeholder="Auto si vacio" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Registro Nacional *</label>
                                <input type="text" class="form-control form-control-sm" value="@NuevoRegistro" @oninput="e => NuevoRegistro = e.Value?.ToString() ?? string.Empty" placeholder="12345" required inputmode="numeric" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Apellidos y Nombres *</label>
                                <input type="text" class="form-control form-control-sm" value="@NuevoNombre" @oninput="e => NuevoNombre = e.Value?.ToString() ?? string.Empty" placeholder="BLANCO COCA VICTOR WILFREDO" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Cedula Identidad</label>
                                <input type="text" class="form-control form-control-sm text-uppercase" value="@NuevoCI" @oninput="e => NuevoCI = e.Value?.ToString()?.ToUpperInvariant() ?? string.Empty" placeholder="1234567 LP" maxlength="20" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Vigente</label>
                                <select class="form-select form-select-sm" @bind="NuevoVigente">
                                    <option value="true">Si</option>
                                    <option value="false">No</option>
                                </select>
                            </div>
                        </div>
                        @if (MensajeModal is not null)
                        {
                            <div class="alert @(ExitoModal ? "alert-success" : "alert-danger") py-2 px-3 small mt-3 mb-0">
                                @MensajeModal
                            </div>
                        }
                        <div class="d-flex gap-2 mt-3 justify-content-end">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModalNuevo">Cancelar</button>
                            <button type="submit" class="btn btn-primary" disabled="@GuardandoModal">
                                @TextoBotonGuardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long TamanoMaximo = 10L * 1024 * 1024;
    private const int PageSize = 50;

    private IBrowserFile? archivo;
    private string? nombreArchivo;
    private long tamanoArchivo;
    private bool archivoSeleccionado;
    private bool procesando;
    private string? mensaje;
    private bool exito;
    private ResultadoCarga? resultado;
    private List<Afiliado>? afiliadosGuardados;

    // Paginación resultados
    private int ResultadoPage = 1;

    // Paginación guardados
    private int GuardadosPage = 1;

    // Selección múltiple
    private HashSet<string> Seleccionados = new();

    // Modal nuevo/editar afiliado
    private bool MostrarModalNuevo = false;
    private Afiliado? EditandoAfiliado = null;
    private string NuevoCorrelativo = string.Empty;
    private string NuevoRegistro = string.Empty;
    private string NuevoNombre = string.Empty;
    private string NuevoCI = string.Empty;
    private bool NuevoVigente = true;
    private bool GuardandoModal = false;
    private string TextoBotonGuardar => GuardandoModal ? "Guardando..." : "Guardar";
    private string? MensajeModal = null;
    private bool ExitoModal = false;

    private bool ReemplazarDuplicados { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        afiliadosGuardados = await Afiliados.ObtenerAfiliadosAsync();
    }

    // Paginación resultados
    private int TotalResultadoPages => resultado?.Afiliados != null
        ? (int)Math.Ceiling((double)resultado.Afiliados.Count / PageSize)
        : 1;

    private IEnumerable<Afiliado> GetPaginatedResultados()
    {
        if (resultado?.Afiliados == null) return Enumerable.Empty<Afiliado>();
        return resultado.Afiliados.Skip((ResultadoPage - 1) * PageSize).Take(PageSize);
    }

    private void CambiarPaginaResultado(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalResultadoPages)
        {
            ResultadoPage = pagina;
        }
    }

    // Paginación guardados
    private int TotalGuardadosPages => afiliadosGuardados != null
        ? (int)Math.Ceiling((double)afiliadosGuardados.Count / PageSize)
        : 1;

    private IEnumerable<Afiliado> GetPaginatedGuardados()
    {
        if (afiliadosGuardados == null) return Enumerable.Empty<Afiliado>();
        return afiliadosGuardados.Skip((GuardadosPage - 1) * PageSize).Take(PageSize);
    }

    private void CambiarPaginaGuardados(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalGuardadosPages)
        {
            GuardadosPage = pagina;
        }
    }

    // Selección múltiple
    private bool SeleccionarTodos
    {
        get => GetPaginatedGuardados().All(a => Seleccionados.Contains(a.NumeroRegistro));
        set => ToggleSeleccionarTodos();
    }

    private void ToggleSeleccionarTodos()
    {
        var items = GetPaginatedGuardados().ToList();
        if (items.All(a => Seleccionados.Contains(a.NumeroRegistro)))
        {
            foreach (var a in items) Seleccionados.Remove(a.NumeroRegistro);
        }
        else
        {
            foreach (var a in items) Seleccionados.Add(a.NumeroRegistro);
        }
    }

    private void ToggleSeleccion(string numeroRegistro, bool seleccionado)
    {
        if (seleccionado) Seleccionados.Add(numeroRegistro);
        else Seleccionados.Remove(numeroRegistro);
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        archivo = e.File;
        nombreArchivo = e.File.Name;
        tamanoArchivo = e.File.Size;
        archivoSeleccionado = true;
        mensaje = null;
        exito = false;
        resultado = null;
    }

    private async Task ProcesarArchivo()
    {
        if (archivo is null) return;

        procesando = true;
        mensaje = null;
        exito = false;
        resultado = null;

        try
        {
            using var memoryStream = new MemoryStream();
            await archivo.OpenReadStream(TamanoMaximo).CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            resultado = await Afiliados.CargarDesdeExcelAsync(memoryStream);
            exito = resultado.Exitoso;
            mensaje = resultado.Mensaje;
            ResultadoPage = 1;
        }
        catch (Exception ex)
        {
            resultado = null;
            exito = false;
            mensaje = $"Error: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task GuardarAfiliados()
    {
        if (resultado?.Afiliados is null || !resultado.Exitoso) return;

        var (exitoso, msg, total, reemplazados, mantenidos) =
            await Afiliados.GuardarConManejoDuplicadosAsync(resultado.Afiliados, ReemplazarDuplicados);

        if (exitoso)
        {
            afiliadosGuardados = await Afiliados.ObtenerAfiliadosAsync();
            resultado = null;
            archivo = null;
            archivoSeleccionado = false;
            mensaje = msg;
            exito = true;
            GuardadosPage = 1;
        }
        else
        {
            mensaje = msg;
            exito = false;
        }
    }

    private void LimpiarArchivo()
    {
        archivo = null;
        nombreArchivo = null;
        tamanoArchivo = 0;
        archivoSeleccionado = false;
        mensaje = null;
        exito = false;
        resultado = null;
    }

    private async Task LimpiarTodo()
    {
        await Afiliados.LimpiarAsync();
        afiliadosGuardados = null;
        resultado = null;
        mensaje = "Todos los afiliados fueron eliminados.";
        exito = false;
        Seleccionados.Clear();
    }

    private async Task ConfirmarEliminarTodo()
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", "Eliminar TODOS los afiliados guardados?");
        if (confirmado) await LimpiarTodo();
    }

    // Eliminar seleccionados
    private async Task EliminarSeleccionados()
    {
        if (!Seleccionados.Any()) return;

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Eliminar {Seleccionados.Count} afiliados seleccionados?");
        if (!confirmado) return;

        var lista = await Afiliados.ObtenerAfiliadosAsync();
        lista = lista.Where(a => !Seleccionados.Contains(a.NumeroRegistro)).ToList();
        await Afiliados.GuardarAsync(lista);
        afiliadosGuardados = lista;
        Seleccionados.Clear();
        mensaje = $"Se eliminaron {Seleccionados.Count} afiliados.";
        exito = true;
    }

    // Eliminar uno
    private async Task ConfirmarEliminarUno(Afiliado afiliado)
    {
        var confirmado = await JS.InvokeAsync<bool>("confirm", $"Eliminar a {afiliado.Nombre} (Reg. {afiliado.NumeroRegistro})?");
        if (!confirmado) return;

        var lista = await Afiliados.ObtenerAfiliadosAsync();
        lista = lista.Where(a => a.NumeroRegistro != afiliado.NumeroRegistro).ToList();
        await Afiliados.GuardarAsync(lista);
        afiliadosGuardados = lista;
        Seleccionados.Remove(afiliado.NumeroRegistro);
        mensaje = "Afiliado eliminado.";
        exito = true;
    }

    // Modal nuevo/editar
    private void AbrirModalNuevoAfiliado()
    {
        MostrarModalNuevo = true;
        EditandoAfiliado = null;
        LimpiarModal();
    }

    private void CerrarModalNuevo()
    {
        MostrarModalNuevo = false;
        EditandoAfiliado = null;
        LimpiarModal();
        MensajeModal = null;
    }

    private void LimpiarModal()
    {
        NuevoCorrelativo = string.Empty;
        NuevoRegistro = string.Empty;
        NuevoNombre = string.Empty;
        NuevoCI = string.Empty;
        NuevoVigente = true;
        MensajeModal = null;
        ExitoModal = false;
    }

    private async Task GuardarAfiliadoModal()
    {
        if (string.IsNullOrWhiteSpace(NuevoRegistro) || string.IsNullOrWhiteSpace(NuevoNombre))
        {
            MensajeModal = "Registro y Nombre son obligatorios.";
            ExitoModal = false;
            return;
        }

        GuardandoModal = true;
        MensajeModal = null;

        try
        {
            var lista = await Afiliados.ObtenerAfiliadosAsync();

            if (EditandoAfiliado != null)
            {
                // Editar existente
                var idx = lista.FindIndex(a => a.NumeroRegistro == EditandoAfiliado.NumeroRegistro);
                if (idx >= 0)
                {
                    lista[idx] = new Afiliado
                    {
                        Correlativo = NuevoCorrelativo,
                        NumeroRegistro = NuevoRegistro.Trim(),
                        Nombre = NuevoNombre.Trim(),
                        CI = NuevoCI.Trim(),
                        Vigente = NuevoVigente
                    };
                }
            }
            else
            {
                // Nuevo
                if (lista.Any(a => a.NumeroRegistro == NuevoRegistro.Trim()))
                {
                    MensajeModal = "Ya existe un afiliado con ese numero de registro.";
                    ExitoModal = false;
                    GuardandoModal = false;
                    return;
                }

                lista.Add(new Afiliado
                {
                    Correlativo = string.IsNullOrWhiteSpace(NuevoCorrelativo)
                        ? (lista.Count + 1).ToString()
                        : NuevoCorrelativo.Trim(),
                    NumeroRegistro = NuevoRegistro.Trim(),
                    Nombre = NuevoNombre.Trim(),
                    CI = NuevoCI.Trim(),
                    Vigente = NuevoVigente
                });
            }

            await Afiliados.GuardarAsync(lista);
            afiliadosGuardados = lista;
            CerrarModalNuevo();
            mensaje = EditandoAfiliado != null ? "Afiliado actualizado." : "Afiliado agregado.";
            exito = true;
        }
        catch (Exception ex)
        {
            MensajeModal = $"Error: {ex.Message}";
            ExitoModal = false;
        }
        finally
        {
            GuardandoModal = false;
        }
    }
}