@page "/reglamento"
@inject IJSRuntime Js

<PageTitle>Reglamento de Aranceles 2026 | CAO</PageTitle>

<h1 class="h4 mb-1">Reglamento de Aranceles 2026</h1>
<p class="text-secondary small mb-3">
    Documento base para el cálculo de honorarios profesionales del Colegio de Arquitectos de Oruro.
</p>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="button" class="btn btn-success" @onclick="DescargarPdf">
                <span class="me-1">&#128424;</span> Descargar PDF
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ImprimirPdf">
                <span class="me-1">&#128438;</span> Imprimir
            </button>
            <a class="btn btn-outline-primary" href="https://www.cao.org.bo" target="_blank" rel="noopener">
                <span class="me-1">&#127760;</span> Web oficial CAO
            </a>
        </div>

        @if (_pdfExiste)
        {
            <div class="ratio ratio-16x10" style="max-height: 70vh;">
                <iframe src="reglamento-aranceles-2026.pdf#toolbar=1&navpanes=0"
                        title="Reglamento de Aranceles 2026"
                        class="border rounded"
                        allowfullscreen>
                </iframe>
            </div>
            <p class="small text-secondary mt-2">
                Si el visor no carga, usa <button type="button" class="btn btn-link p-0" @onclick="DescargarPdf">Descargar PDF</button>.
            </p>
        }
        else
        {
            <div class="alert alert-warning d-flex align-items-center gap-2">
                <span class="me-2">&#9888;</span>
                <div>
                    <strong>PDF del reglamento no encontrado.</strong>
                    Coloca el archivo <code>reglamento-aranceles-2026.pdf</code> en <code>wwwroot/</code>
                    y vuelve a publicar.
                </div>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm border-0 mt-3">
    <div class="card-body">
        <h2 class="h6 mb-2">Resumen de áreas principales</h2>
        <div class="table-responsive">
            <table class="table table-sm small align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5rem">Área</th>
                        <th>Descripción</th>
                        <th class="text-end">Base cálculo</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td class="fw-semibold">1</td><td>Servicios de arquitectura</td><td class="text-end">CH × M² × h(k,r) × Fa × Fj</td></tr>
                    <tr><td class="fw-semibold">2A</td><td>Lotes y fraccionamiento</td><td class="text-end">max(Precio × M², Hbase) + 5,5 % PI</td></tr>
                    <tr><td class="fw-semibold">3</td><td>Remodelación, restauración, patrimonio</td><td class="text-end">Fórmula Área 1 × Fj (1,10–1,25)</td></tr>
                    <tr><td class="fw-semibold">4A</td><td>Avalúos, peritajes, dirimición</td><td class="text-end">Valor × 3/1000 o 6/1000</td></tr>
                    <tr><td class="fw-semibold">4B</td><td>Inspecciones y auditorías</td><td class="text-end">Hbase × multiplicador (0,50–1,50)</td></tr>
                    <tr><td class="fw-semibold">6</td><td>Plantas tipo y proyectos repetidos</td><td class="text-end">Escala decreciente sobre unidad base</td></tr>
                </tbody>
            </table>
        </div>
        <p class="small text-secondary mt-2 mb-0">
            Variable Vida (V) = Bs 8.935,16 &middot; Horas mensuales = 160 &middot; CH = V/160 = Bs 55,84 &middot; Hbase = V/4 = Bs 2.233,79
        </p>
    </div>
</div>

@code {
    private bool _pdfExiste;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _pdfExiste = await Js.InvokeAsync<bool>("caoPdf.verificarArchivo", "reglamento-aranceles-2026.pdf");
            StateHasChanged();
        }
    }

    private async Task DescargarPdf()
    {
        await Js.InvokeVoidAsync("caoPdf.descargarArchivo", "reglamento-aranceles-2026.pdf", "Reglamento-Aranceles-CAO-2026.pdf");
    }

    private async Task ImprimirPdf()
    {
        await Js.InvokeVoidAsync("caoPdf.imprimirArchivo", "reglamento-aranceles-2026.pdf");
    }
}
